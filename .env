# Google Form URL cần tự động điền
FORM_URL=https://docs.google.com/forms/d/e/your-form-id/viewform

# Gemini API key hoặc key qua gateway tương thích
GEMINI_API_KEY=replace_with_your_api_key

# Gemini model (theo yêu cầu)
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: endpoint gateway tương thích OpenAI/Google nếu có
# Ví dụ: GEMINI_API_BASE=generativelanguage.googleapis.com
GEMINI_API_BASE=

# Chế độ chạy Playwright
HEADLESS=false
USER_DATA_DIR=./user_data
