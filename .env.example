# ── Trình duyệt ───────────────────────────────────────────────────────────────
# Luồng nộp thủ công yêu cầu trình duyệt hiển thị, không đổi thành true.
HEADLESS=false
USER_DATA_DIR=./user_data

# ── Local AI (OpenAI-compatible) ──────────────────────────────────────────────
# Dùng server AI local của bạn thay vì gọi API của OpenAI.
AI_PROVIDER=openai_compatible

# Địa chỉ base URL của server local (thường kết thúc bằng /v1).
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1

# API key nếu server yêu cầu xác thực. Để trống nếu không cần.
OPENAI_COMPATIBLE_API_KEY=

# Tên model đang chạy trên server local của bạn, ví dụ: llama3, mistral, qwen2.5.
OPENAI_COMPATIBLE_MODEL=

# ── Cài đặt AI chung ──────────────────────────────────────────────────────────
AI_BATCH_SIZE=8
AI_TIMEOUT_SECONDS=60
AI_RETRY_ATTEMPTS=5
AI_RETRY_BASE_SECONDS=3

# ── OpenRouter (đổi AI_PROVIDER=openrouter để dùng) ──────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Gemini (đổi AI_PROVIDER=gemini để dùng) ───────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_BASE=

# ── URL form (tùy chọn khi chạy main.py trực tiếp) ───────────────────────────
FORM_URL=
